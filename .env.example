# Copy to .env (make does this automatically). Values here override configs/finguard.yaml.

# Dataset scale: small (100K) | medium (1M) | large (10M) | any integer
DATASET_SIZE=small
SIM_DAYS=180
SIM_SEED=42

# Streaming replay rate (events/second) for `make replay`
REPLAY_RATE=250

# Host user id for files written into ./data ./models ./reports by containers
UID=1000
GID=1000

LOG_LEVEL=INFO

# Optional: CA bundle used only while building images behind a TLS-intercepting proxy
# EXTRA_CA_CERT=/path/to/ca-bundle.crt
